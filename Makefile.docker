DOCKER_REGISTRY ?= docker.io

# BUILD_TARGET selects where `make build` runs. `local` (the default) uses the
# local Docker daemon; any other value names a cluster alias (sun / nukedev /
# nukeprod) or a kubectl context and builds inside that cluster as a Job
# rendered from hack/build-job.yaml.
BUILD_TARGET ?= local
BUILD_NAMESPACE ?= build
BUILD_TIMEOUT ?= 3600
BUILD_DOCKERFILE ?= Dockerfile
BUILD_PUSH_SECRET ?= buildkit-push

# The local arm tags $(DOCKER_REGISTRY)/bborbe/$(SERVICE) with the operator's
# own Docker credentials.
#
# The cluster arm pushes somewhere else on purpose: the build lane's
# buildkit-push credential authenticates against Docker Hub, so the cluster arm
# pushes docker.io/bborbe/$(SERVICE). The private-registry copy the deployment
# pulls is produced by nuke's MIRROR_IMAGES step, not by this build.
CLUSTER_IMAGE ?= docker.io/bborbe/$(SERVICE)

# SERVICE is the bare repository name here (github-vuln-watcher), not
# bborbe/$(SERVICE) as in go-skeleton, so the clone URL spells the prefix out.
BUILD_REPO_URL ?= https://github.com/bborbe/$(SERVICE).git

ifeq ($(VERSION),)
	VERSION := $(shell git describe --tags `git rev-list --tags --max-count=1`)
endif

# The version guard is a local-arm guard: an image stamped vX.Y.Z must be built
# from the vX.Y.Z tag. The cluster arm builds an explicit REF at an explicit
# scratch TAG, so neither prerequisite applies there.
.PHONY: build
ifeq ($(BUILD_TARGET),local)
build: check-version-tag check-go-mod
else
build:
endif
ifeq ($(BUILD_TARGET),local)
	@if [ -z "$(VERSION)" ]; then echo "ERROR: no VERSION set and no git tag found — set VERSION=vX.Y.Z or create a tag" >&2; exit 1; fi
	DOCKER_BUILDKIT=1 \
	docker build \
	--pull \
	--no-cache \
	--rm=true \
	--platform=linux/amd64 \
	--build-arg DOCKER_REGISTRY=$(DOCKER_REGISTRY) \
	--build-arg BUILD_GIT_VERSION=$(VERSION) \
	--build-arg BUILD_GIT_COMMIT=$$(git rev-parse --short HEAD) \
	--build-arg BUILD_DATE=$$(date -u +%Y-%m-%dT%H:%M:%SZ) \
	-t $(DOCKER_REGISTRY)/bborbe/$(SERVICE):$(VERSION) \
	-f Dockerfile .
else
# VERSION is defaulted above for the local arm, so an unset VERSION on the
# cluster arm would silently publish the last released tag from whatever tree
# this is. Refuse unless it was passed in explicitly.
	@if [ "$(origin VERSION)" != "command line" ] && [ "$(origin VERSION)" != "environment" ]; then \
		echo "ERROR: BUILD_TARGET=$(BUILD_TARGET) needs an explicit VERSION; refusing to publish the auto-derived tag $(VERSION)" >&2; \
		exit 1; \
	fi
	@echo "$(CLUSTER_IMAGE):$(VERSION)"
	BUILD_TARGET='$(BUILD_TARGET)' \
	NAMESPACE='$(BUILD_NAMESPACE)' \
	REPO_URL='$(BUILD_REPO_URL)' \
	REF='$(REF)' \
	TAG='$(VERSION)' \
	DOCKERFILE='$(BUILD_DOCKERFILE)' \
	IMAGE='$(CLUSTER_IMAGE)' \
	PUSH='true' \
	PUSH_SECRET='$(BUILD_PUSH_SECRET)' \
	TIMEOUT='$(BUILD_TIMEOUT)' \
	hack/build-cluster.sh
endif

.PHONY: check-version-tag
check-version-tag:
	@if [ -n "$(ALLOW_UNTAGGED_BUILD)" ]; then \
		echo "ALLOW_UNTAGGED_BUILD set — skipping version/tag check"; \
	else \
		head_tag=$$(git describe --tags --exact-match HEAD 2>/dev/null); \
		if [ "$$head_tag" != "$(VERSION)" ]; then \
			echo "ERROR: refusing to build $(VERSION) from this tree." >&2; \
			echo "  HEAD is at tag: $${head_tag:-<untagged>}" >&2; \
			echo "  building as:    $(VERSION)" >&2; \
			echo "  An image stamped vX.Y.Z must be built from the vX.Y.Z tag." >&2; \
			echo "  Fix: git checkout $(VERSION)   (or set ALLOW_UNTAGGED_BUILD=1 for a scratch build)" >&2; \
			exit 1; \
		fi; \
	fi

.PHONY: check-go-mod
check-go-mod:
	@if [ -f "go.mod" ]; then \
		echo "go.mod found, running go mod vendor..."; \
		go mod vendor; \
	else \
		echo "go.mod not found, skipping go mod vendor."; \
	fi

# A remote target pushes from inside the cluster and never loads the image on
# this machine, so there is nothing here to push and nothing to remove. Guard
# both, or `make buca BUILD_TARGET=<cluster>` fails at the push step after a
# build that actually succeeded.
.PHONY: upload
upload:
ifeq ($(BUILD_TARGET),local)
	docker push $(DOCKER_REGISTRY)/bborbe/$(SERVICE):$(VERSION)
endif

.PHONY: clean
clean:
ifeq ($(BUILD_TARGET),local)
	docker rmi $(DOCKER_REGISTRY)/bborbe/$(SERVICE):$(VERSION) || true
	docker builder prune --all -f || true
	rm -rf vendor
endif

# Publish-only: no k8s in this repo. Deployment is the github-vuln-watcher
# Helm chart, mirrored into the quant registry and pinned by tag in
# quant/github-vuln-watcher/. apply is a no-op placeholder.
.PHONY: apply
apply:
	@echo "skip apply — publish-only"

# Operator-run publish to Docker Hub (requires `docker login`). CI runs
# `make precommit`, never `buca`, so the unconditional push is safe.
.PHONY: buca
buca: build upload clean apply
